{
  "name": "lora-dataset-studio",
  "productName": "LoRA Dataset Studio",
  "version": "1.6.0",
  "description": "Desktop dataset studio for diffusion/LoRA training: ingest, crop, rename, caption with local Ollama vision models, and export image/caption pairs.",
  "main": "main.js",
  "author": "LoRA Dataset Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "cropperjs": "^1.6.3",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.lora-dataset-studio",
    "productName": "LoRA Dataset Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "datasets.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": "dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "Webcam capture is used to add snapshots to your dataset."
      }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  }
}
